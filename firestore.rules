// firestore.rules
// ─────────────────────────────────────────────────────────────
// Nampidirina (2026-09) miaraka amin'ny Firestore "realtime listener"
// (onSnapshot, jereo src/firebase.js sy Game.vue) — nampiasa ilay
// Firebase client SDK ho an'ny "gameStates/{roomId}" ihany, mba
// hampihena ny "polling" HTTP (izay nahalany haingana ny quota
// "lecture" Firestore, jereo comment ao Game.vue → GAME_POLL_MS).
//
// ── "gameStates/{roomId}" — vakiana mivantana amin'ny client ────────
// Tsy misy angona "sensible" ao anatin'ity document ity: tsy misy
// uid/username/avatar, mot de passe, na mise — ny "turnOrder"/
// "turnIndex"/"pendingValue"/"lastRoll"/"piecesOut"/"rollSeq"/
// "sixStreak" (jereo api/game.js) dia "isa"/"array isa" fotsiny (ohatra:
// "lastRoll.slotIndex" dia 0-3 [couleur ao amin'ny board], TSY uid).
// Noho izany dia "request.auth != null" (mpampiasa manana session
// Firebase Auth marina, na iza na iza izy) ihany no takiana amin'ny
// "read" — TSY voafetra amin'ireo mpilalao AO ANATY io salon io ihany
// (izay mitaky "cross-document lookup" any amin'ny "rooms/{roomId}"
// lava kokoa hampiharina, ka tsy nataon'ity version voalohany ity — jereo
// fanazavana nomena ny mpampiasa: azo atao any aoriana raha ilaina).
//
// "write" dia voarara TANTERAKA amin'ny client (allow write: if false)
// — ny SERVER (firebase-admin, api/game.js → action "roll") ihany no
// manoratra azy io, satria ny "admin SDK" dia MANDINGANA ("bypass")
// ireto "rules" ireto foana, na inona na inona lazain'izy ireo.
//
// ── Ny sisa rehetra (rooms, users, roomInvites, sns) ────────────────
// Mijanona "admin ihany" tsy misy fiovana — ny client dia mandeha
// amin'ny alalan'ny api/*.js (firebase-admin) foana ho an'ireo, tsy
// mahazo mamaky/manoratra mivantana amin'ny Firestore (misy angona
// "sensible" toy ny "password"/"stake" ao amin'ny "rooms/{roomId}").
// ─────────────────────────────────────────────────────────────
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /gameStates/{roomId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
